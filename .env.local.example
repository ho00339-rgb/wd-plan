# 아래를 복사해 .env.local 로 만들고 값을 채우세요 (이 파일은 예시라 커밋 OK, .env.local 은 커밋 안 됨)

# Anthropic API 키 (console.anthropic.com 에서 발급)
# 챗봇(/api/chat)과 AI 위키 수정안 생성(/api/propose)에 필요
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 사용할 모델. 챗봇과 수정안 생성이 같이 씁니다.
# 미설정 시 챗봇은 claude-sonnet-5, 수정안 생성은 claude-sonnet-5-5
# (수정안 생성은 claude 로 시작하지 않는 값을 무시하고 기본값을 씁니다)
# ANTHROPIC_MODEL=claude-sonnet-5-5


# ── AI 위키 업데이트 기능 (/update) ───────────────────────────────

# 수정안 생성은 위의 ANTHROPIC_API_KEY / ANTHROPIC_MODEL 을 씁니다 (OPENAI_MODEL 은 더 이상 안 씀)

# OpenAI API 키 (platform.openai.com 에서 발급) — 음성 녹음 → 텍스트 변환(/api/transcribe)에만 필요
# Claude API 에는 음성 인식이 없어서 이 기능만 OpenAI 를 씁니다. 없으면 음성 변환만 안 되고 나머지는 동작합니다
OPENAI_API_KEY=sk-proj-...

# 오디오 → 텍스트 변환 모델
OPENAI_TRANSCRIBE_MODEL=whisper-1

# 업데이트 기능 비밀키. 이 값이 없으면 업데이트 기능 전체가 꺼집니다.
# 위키 읽기는 공개지만, 쓰기는 이 키를 아는 사람만 할 수 있습니다
UPDATE_SECRET=아무도_모르는_긴_문자열

# 변경 내용을 커밋할 저장소와 브랜치
GITHUB_REPO=ho00339-rgb/wd-plan
GITHUB_BRANCH=main

# contents:write 권한이 있는 GitHub 토큰
# github.com/settings/personal-access-tokens 에서 이 저장소만 지정해 발급하세요
GITHUB_TOKEN=github_pat_...
